<!DOCTYPE html>
<html lang="en" class="h-full" data-theme="<%= cookies[:theme] %>">
  <head>
    <title><%= content_for(:title) || "Drift" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="application-name" content="Drift">
    <% case cookies[:theme] %>
    <% when "light" %>
      <meta name="theme-color" content="#f5f5f4">
    <% when "dark" %>
      <meta name="theme-color" content="#181614">
    <% else %>
      <meta name="theme-color" content="#f5f5f4">
      <meta name="theme-color" content="#181614" media="(prefers-color-scheme: dark)">
    <% end %>
    <%= tag.meta name: "rails-env", content: Rails.env %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="term term-screen h-full bg-stone-50 text-stone-900 antialiased">
    <main class="flex min-h-dvh items-center justify-center px-4">
      <div class="w-full max-w-md">
        <%= render "shared/flash" %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
