<% content_for :title, "Authorize CLI" %>

<div class="mx-auto max-w-lg px-6 py-10">
  <p class="text-sm">
    <span class="text-amber-700">drift</span><span class="text-stone-400">:</span><span class="text-stone-500">~/cli</span><span class="term-caret select-none" aria-hidden="true"></span>
  </p>
  <h1 class="mt-4 text-base font-semibold tracking-tight text-stone-900">Authorize the Drift CLI?</h1>
  <p class="mt-3 text-sm text-stone-600">
    The CLI on this computer will be able to read your inbox as
    <span class="text-stone-900"><%= Current.user.email_address %></span>.
    You can revoke the token later under Account → API tokens.
  </p>

  <%= form_with url: cli_authorize_path, data: { turbo: false }, class: "mt-6 space-y-3" do %>
    <%= hidden_field_tag :redirect_uri, @redirect_uri %>
    <%= hidden_field_tag :state, @state %>
    <%= submit_tag "Authorize CLI", class: "term-submit" %>
  <% end %>

  <p class="mt-4 text-sm">
    <%= link_to "Cancel", CliAuthorization.denied_url(@redirect_uri, @state), class: "underline underline-offset-2 text-stone-500 hover:text-stone-900" %>
  </p>
</div>
