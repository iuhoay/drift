#!/usr/bin/env bash

# Fizzy-style GitHub Release after a successful production deploy.
# https://github.com/basecamp/fizzy/blob/main/saas/.kamal/hooks/post-deploy
#
# Tag is KAMAL_SERVICE_VERSION (drift@<7-char-sha>). A failed release must not
# fail the deploy — the app is already live.

echo "$KAMAL_PERFORMER deployed $KAMAL_SERVICE_VERSION in ${KAMAL_RUNTIME}s"

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [[ "$CURRENT_BRANCH" == "main" && "${KAMAL_DESTINATION:-production}" == "production" ]]; then
  # origin is GitHub. Push the tag (and the deployed SHA) so `gh release create`
  # has something to point at.
  git push origin "$KAMAL_VERSION:refs/tags/$KAMAL_SERVICE_VERSION" || true
  gh release create "$KAMAL_SERVICE_VERSION" --generate-notes || true

  # Mark the deploy on Rails Pulse charts. Records inside the app container via
  # the gem's rake task; inner single quotes are the remote-bash quoting layer
  # (same transport rule as bin/kamal query). || true: a failed marker must not
  # fail a live deploy.
  bin/kamal app exec --reuse "bin/rails 'rails_pulse:record_deployment[$KAMAL_SERVICE_VERSION]'" || true
fi
